# Any PostgreSQL connection string. For a deployed instance this comes from
# your database host (Neon, Prisma Postgres, Supabase, …). For local work you
# can run your own Postgres, or simply reuse the deployed database's URL.
DATABASE_URL="postgres://user:password@host:5432/jordancreate"

# Optional: enables GET /api/seed?token=<value> to load the demo data into a
# fresh deployment. Remove (or leave unset) once you have real data.
# SETUP_TOKEN="pick-a-long-random-string"
